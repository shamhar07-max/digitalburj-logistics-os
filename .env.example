# Used by docker-compose. Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=
JWT_SECRET=            # openssl rand -hex 32
ENCRYPTION_KEY=        # openssl rand -hex 32  (encrypts integration secrets at rest — losing it makes them unreadable)
PORT=3001
WEB_ORIGIN=http://localhost:3001
PUBLIC_WEB_URL=http://localhost:3001

# Optional integrations (features degrade gracefully when unset)
ANTHROPIC_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=DigitalBurj <no-reply@example.com>
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_APP_SECRET=
